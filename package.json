{
  "name": "playwright-generate-mcp",
  "version": "0.3.0",
  "description": "MCP server for QA teams: generate Playwright E2E tests from test cases and the live website, then run, score and heal them using a Domain-Driven POM architecture.",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "playwright-generate-mcp": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "node --import tsx --test --test-timeout=120000 \"test/**/*.test.ts\"",
    "test:unit": "node --import tsx --test --test-timeout=60000 \"test/unit/**/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-timeout=120000 \"test/integration/**/*.test.ts\"",
    "test:e2e": "node --import tsx --test --test-timeout=300000 \"test/e2e/**/*.test.ts\"",
    "check:package": "node scripts/check-package.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "author": "baramubarok",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2"
  }
}
